# WebDAV backup completion email (Resend)
RESEND_API_KEY=re_your_api_key
WEBDAV_BACKUP_FROM_EMAIL=WebDAV Backup <backup@your-verified-domain.example>

# Optional when the public URL is not entered in the WebDAV settings screen
WEBDAV_BACKUP_PUBLIC_URL=https://backup.example.com

# Optional: stable encryption key for backup settings across server migrations
WEBDAV_BACKUP_SECRET=replace-with-a-long-random-secret
