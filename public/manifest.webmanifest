{
  "id": "./",
  "name": "WebDAV Viewer",
  "short_name": "WebDAV",
  "description": "태블릿에서도 사용할 수 있는 WebDAV 문서 탐색기와 편집기",
  "lang": "ko-KR",
  "start_url": "./",
  "scope": "./",
